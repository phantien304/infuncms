# ------------------------------------------------------------------
# SPA fallback cho Infun CMS chạy ở root subdomain cms.infun.test
# File này nằm trong public/ nên Vite tự copy sang dist/.htaccess mỗi
# lần `npm run build` (không bị xoá khi clean dist).
#
# Mọi URL không phải file/thư mục thật -> trả về index.html để
# react-router (BrowserRouter, base '/') tự xử lý route phía client.
# ------------------------------------------------------------------

Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bỏ qua nếu là file hoặc thư mục có thật (assets: js/css/img...)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Còn lại -> index.html (SPA entry)
    RewriteRule ^ index.html [L]
</IfModule>

# Cache asset tĩnh (vite gắn hash vào tên file nên cache dài an toàn)
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # index.html không cache để luôn lấy bản build mới
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
